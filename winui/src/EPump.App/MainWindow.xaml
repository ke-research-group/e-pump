<Window
    x:Class="EPump.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:EPump.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Laid out like the NI6451 window: Mica, a settings rail on the left with its buttons
         pinned at the bottom, the live readout on the right, a status bar along the bottom. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= title bar ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ReaXus CP Pump Control" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= notifications ================= -->
        <StackPanel Grid.Row="1" Margin="16,0,16,0" Spacing="8">
            <!-- Safety stops get their own bar, so a later, lesser alert can never replace one. -->
            <InfoBar
                x:Name="SafetyBar"
                IsOpen="False"
                Severity="Error"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ClearFaultButton" Content="Clear pump fault" Click="OnClearFault" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="RecoveryBar"
                IsOpen="False"
                Severity="Warning"
                Title="Interrupted recording found"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="RecoverButton" Content="Recover now" Click="OnRecover" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="AlertBar"
                IsOpen="False"
                Severity="Error"
                IsClosable="True" />
        </StackPanel>

        <!-- ================= body ================= -->
        <Grid Grid.Row="2" Margin="16,12,16,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ————— left rail ————— -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Spacing="12">

                        <!-- pump connection -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE703;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Pump" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PortCombo" Grid.Column="0" Header="Serial port" HorizontalAlignment="Stretch" PlaceholderText="COM…" />
                                    <Button x:Name="RefreshPortsButton" Grid.Column="1" VerticalAlignment="Bottom" Click="OnRefreshPorts" ToolTipService.ToolTip="Rescan serial ports">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <Button x:Name="ConnectButton" HorizontalAlignment="Stretch" Click="OnConnect">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="ConnectIcon" Glyph="&#xE703;" FontSize="14" />
                                        <TextBlock x:Name="ConnectText" Text="Connect" />
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="PumpInfoText" Text="Not connected. The micro-USB port appears as a COM port once the Teledyne SSI driver is installed." Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- flow and limits -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Constant flow" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="FlowBox" Grid.Column="0" Header="Flow (mL/min)" SpinButtonPlacementMode="Compact" SmallChange="0.1" LargeChange="1" />
                                    <NumberBox x:Name="LimitBox" Grid.Column="1" Header="Pressure limit (psi)" SpinButtonPlacementMode="Compact" SmallChange="50" LargeChange="500" />
                                </Grid>

                                <Button x:Name="ApplyButton" Content="Apply to pump" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnApply"
                                        ToolTipService.ToolTip="Send the flow and the pressure limit now. Works while the pump is running." />

                                <ToggleSwitch x:Name="KeypadLockToggle" Header="Lock the pump's front-panel keys while connected" OnContent="Locked" OffContent="Unlocked" Toggled="OnKeypadLockToggled" />

                                <TextBlock x:Name="SafetyCaptionText" Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- naming -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Output naming" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SerialBox" Grid.Column="0" Header="Experiment serial" MaxLength="4" TextChanged="OnNamingChanged" />
                                    <NumberBox x:Name="RnBox" Grid.Column="1" Header="Run" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="OnRunNumberChanged" />
                                    <Button x:Name="SyncNamingButton" Grid.Column="2" VerticalAlignment="Bottom" Click="OnSyncNaming" ToolTipService.ToolTip="Re-read the NI6451 run numbering">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,6">
                                    <TextBlock x:Name="FileNamePreviewText" Style="{StaticResource CardCaptionStyle}" FontFamily="Consolas" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock x:Name="NamingHintText" Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- output folder -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Output folder" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <TextBlock x:Name="OutputFolderText" Text="No folder selected" Style="{StaticResource CardCaptionStyle}" />
                                <Button x:Name="ChooseFolderButton" Content="Choose folder…" HorizontalAlignment="Stretch" Click="OnChooseFolder" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Pinned: the pump controls and the recording controls must never scroll out of reach. -->
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RunPumpButton" Grid.Column="0" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnRunPump"
                                ToolTipService.ToolTip="Send the limit, the pinned set point and the flow, confirm them, then start the pump.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Run pump" />
                            </StackPanel>
                        </Button>

                        <!-- Red, and overriding the button's own brush resources for the same reason the
                             NI6451 Monitor button does: a plain Background is replaced on pointer-over. -->
                        <Button x:Name="StopPumpButton" Grid.Column="1" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnStopPump"
                                ToolTipService.ToolTip="Stop the pump now.">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B02718" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#9A2215" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40C42B1C" />
                                <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#9A2215" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#9A2215" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#801C11" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="STOP PUMP" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="RecordButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnRecord"
                                ToolTipService.ToolTip="Record pressure, flow and events to an .npz in the output folder. Independent of Run/Stop.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7C8;" FontSize="14" />
                                <TextBlock Text="Record" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="StopRecordButton" Grid.Column="1" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnStopRecord"
                                ToolTipService.ToolTip="Stop recording and save the .npz. The pump keeps doing what it is doing.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                <TextBlock Text="Stop recording" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ————— right pane ————— -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- readout tiles -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SubtleCardStyle}" MinWidth="150">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PUMP" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="StateIcon" Glyph="&#xE711;" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="Offline" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="PRESSURE" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PressureText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="psi" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="FLOW" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FlowText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="mL/min" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="SET FLOW" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SetFlowText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="mL/min" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIMIT" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LimitText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="psi" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Window" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="WindowCombo" Width="120" SelectionChanged="OnWindowChanged" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="PRESSURE · psi" Style="{StaticResource ReadoutCaptionStyle}" />
                        <controls:TrendPlot x:Name="PressurePlot" Grid.Row="2" />
                        <TextBlock Grid.Row="3" Text="FLOW · mL/min" Style="{StaticResource ReadoutCaptionStyle}" />
                        <controls:TrendPlot x:Name="FlowPlot" Grid.Row="4" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= status bar ================= -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Idle" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Only meaningful while recording. -->
                <StackPanel x:Name="StatsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="16" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Recording" Style="{StaticResource StatCaptionStyle}" />
                        <TextBlock x:Name="StatElapsed" Text="0:00" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Samples" Style="{StaticResource StatCaptionStyle}" />
                        <TextBlock x:Name="StatSamples" Text="0" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
